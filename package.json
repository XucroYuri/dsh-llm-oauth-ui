{
  "name": "@xucroyuri/dsh-llm-oauth-ui",
  "version": "0.3.0",
  "description": "OAuth login status and future Web UI support for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "specs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh.md",
    "SECURITY.md",
    "SECURITY.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "oauth",
    "login",
    "llm",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XucroYuri/dsh-llm-oauth-ui.git"
  },
  "bugs": {
    "url": "https://github.com/XucroYuri/dsh-llm-oauth-ui/issues"
  },
  "homepage": "https://github.com/XucroYuri/dsh-llm-oauth-ui#readme",
  "author": "XucroYuri",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-llm-oauth-ui": "bin/dsh-llm-oauth-ui.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node --check src/index.js && for f in bin/*.js; do node --check \"$f\"; done",
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check": "node --check src/index.js"
  },
  "sideEffects": false
}
